# ============================================================
# 环境变量模板 —— 复制为 .env 后填写真实值
#   cp .env.example .env && chmod 600 .env
# .env 绝不能提交进 Git（已加入 .gitignore）
# ============================================================

# ---------- MySQL ----------
MYSQL_USER=root
# 用强密码，至少 16 位混合字符
MYSQL_PASSWORD=CHANGE_ME_mysql_strong_password

# ---------- Redis ----------
REDIS_PASSWORD=CHANGE_ME_redis_strong_password

# ---------- RabbitMQ ----------
RABBITMQ_USER=mansicha
RABBITMQ_PASSWORD=CHANGE_ME_rabbitmq_strong_password

# ---------- Nacos 鉴权（2.3.x 起必须显式配置）----------
# identity key/value 用于服务端身份识别，自定义字符串
NACOS_IDENTITY_KEY=CHANGE_ME_nacos_identity_key
NACOS_IDENTITY_VALUE=CHANGE_ME_nacos_identity_value
# token 必须是 Base64 编码且长度 >= 32 字节
# 生成：openssl rand -base64 48
NACOS_AUTH_TOKEN=CHANGE_ME_generate_with_openssl_rand_base64_48

# ---------- LLM ----------
# 生产密钥只放这里，绝不进代码仓库、绝不进前端
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-CHANGE_ME_your_real_api_key

# ---------- 域名（用于 certbot 与文档，代码里不读）----------
DOMAIN=api.your-domain.com
